{
  "id": "pumpkin-bread",
  "name": "Pumpkin Bread",
  "course": "Bread",
  "cookingMethod": "Oven",
  "ingredients": [
    {
      "items": [
        "3 cups sugar",
        "4 beaten eggs",
        "1 can (29 oz) pumpkin",
        "1 cup oil",
        "2/3 cup water",
        "3 1/2 cups flour",
        "2 tsp baking soda",
        "1 tsp baking powder",
        "1 tsp salt",
        "1 tsp cinnamon",
        "1 tsp nutmeg",
        "1 tsp allspice",
        "1/4 tsp cloves"
      ]
    }
  ],
  "instructions": [
    {
      "items": [
        "Blend all liquid ingredients.",
        "Mix in dry ingredients.",
        "Pour into two greased loaf pans.",
        "Bake at 350°F for 30-35 minutes."
      ]
    }
  ],
  "contributor": "Sharmi"
}
