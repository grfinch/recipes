{
  "id": "hot-fudge-sauce",
  "name": "Hot Fudge Sauce",
  "course": "Sauce",
  "cookingMethod": "No-cook",
  "ingredients": [
    {
      "items": [
        "1 cup semi-sweet chocolate chips",
        "1/2 cup evaporated milk",
        "1/4 cup sugar",
        "1 Tbsp butter"
      ]
    }
  ],
  "instructions": [
    {
      "items": [
        "Melt all ingredients together in the microwave, stirring every 30 seconds until melted and creamy."
      ]
    }
  ],
  "contributor": "Sharmi"
}
