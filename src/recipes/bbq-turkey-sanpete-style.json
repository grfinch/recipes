  "course": "Dinner",
  "cookingMethod": "Grill",
  "ingredients": [
    {
      "title": "Marinade",
      "items": [
        "2 parts 7-Up or Sprite",
        "1 part soy sauce",
        "1 part vegetable oil",
        "1/2 tsp horseradish",
        "1/4 tsp garlic powder"
      ]
    },
    {
      "items": ["Turkey"]
    }
  ],
  "instructions": [
    {
      "items": [
        "Make enough marinade to cover meat.",
        "Mix everything together thoroughly and marinate meat for 18-24 hours.",
        "Grill, turning frequently."
      ]
    }
  ]
}
