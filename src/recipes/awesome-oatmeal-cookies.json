{
  "id": "awesome-oatmeal-cookies",
  "name": "Awesome Oatmeal Cookies",
  "course": "Dessert",
  "cookingMethod": "Oven",
  "ingredients": [
    {
      "title": "Wet",
      "items": [
        "1/2 cup pureed pears or 1/3 cup applesauce",
        "3/4 cup mashed white beans",
        "3 Tbsp canola oil or vegetable oil",
        "3/4 cup brown sugar",
        "1/2 cup granulated sugar",
        "1 egg",
        "1 tsp vanilla"
      ]
    },
    {
      "title": "Dry",
      "items": [
        "1 tsp salt",
        "1/2 tsp baking soda",
        "1 tsp cinnamon",
        "3 cups quick oats",
        "3/4 cup whole wheat flour"
      ]
    }
  ],
  "instructions": [
    {
      "items": [
        "Beat first 7 ingredients together until creamy.",
        "Mix in dry ingredients.",
        "Drop on a greased cookie sheet and bake at 350°F for 10-12 minutes."
      ]
    }
  ],
  "notes": [
    {
      "items": ["Can add chocolate chips, nuts, raisins, or coconut if desired."]
    }
  ]
}
