# Copy to .env.local (gitignored) to try the suggest page against a relay in development.
# In CI these come from the repo variables SUGGEST_ENDPOINT and TURNSTILE_SITE_KEY.
# Leave VITE_SUGGEST_ENDPOINT empty and the page shows a link to GitHub issues instead.
VITE_SUGGEST_ENDPOINT=
# Optional. Cloudflare's always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
