# The same checks as CI's `check` job, so a push can't fail them.
# Skip in an emergency with `git push --no-verify`.
set -e

# Run from git's path to the repo. On Windows it has an uppercase drive letter (C:/...);
# from a lowercase one (c:\..., as VS Code may open the folder) Vitest fails with
# "failed to find the current suite". See AGENTS.md.
cd "$(git rev-parse --show-toplevel)"

npm run lint
npm run format:check
npm run validate:recipes
npm test
npm run build

# Browser checks (CSS, contrast, native behavior), as in CI. The driver's own dependency
# (playwright-core, which uses your installed Chrome) is installed on first use. Port 5199
# with --fresh, so it never tests a dev server that's running other code.
[ -d .claude/skills/run-recipes/node_modules ] || npm install --prefix .claude/skills/run-recipes --silent --no-audit --no-fund
RECIPES_PORT=5199 node .claude/skills/run-recipes/driver.mjs regression --fresh
