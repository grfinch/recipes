{
  "id": "creamy-jalapeno-ranch",
  "name": "Creamy Jalapeño Ranch",
  "course": "Sauce",
  "cookingMethod": "No-cook",
  "ingredients": [
    {
      "items": [
        "1/2 cup mayonnaise",
        "2 cups sour cream",
        "1/2 cup buttermilk",
        "1/2 cup tomatillo salsa",
        "Handful of cilantro",
        "1/3 cup pickled jalapeños",
        "1 1/2 packets buttermilk ranch dressing mix",
        "Juice of 1 lime"
      ]
    }
  ],
  "instructions": [
    {
      "items": ["Place all ingredients in a blender and blend."]
    }
  ],
  "contributor": "Sharmi"
}
